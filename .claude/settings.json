{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git branch -a:*)",
      "Bash(git worktree list:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform -chdir=* fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform -chdir=* validate:*)",
      "Bash(terraform init -backend=false:*)",
      "Bash(terraform -chdir=* init -backend=false:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform -chdir=* plan:*)",
      "Bash(terraform show:*)",
      "Bash(terraform -chdir=* show:*)",
      "Bash(tflint:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv sync:*)",
      "Bash(npm --prefix app/web run lint:*)",
      "Bash(npm --prefix app/web run test:*)",
      "Bash(npm --prefix app/web run build:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl apply --dry-run=client:*)",
      "Bash(az account show:*)",
      "Bash(az account list:*)",
      "Bash(az group list:*)",
      "Bash(az resource list:*)",
      "Bash(az provider show:*)",
      "Bash(az provider list:*)",
      "Bash(az vm list-usage:*)",
      "Bash(az vm list-skus:*)",
      "Bash(az aks show:*)",
      "Bash(az aks list:*)",
      "Bash(az aks get-versions:*)",
      "Bash(az role assignment list:*)",
      "Bash(az storage account show:*)",
      "Bash(az keyvault show:*)",
      "Bash(az acr show:*)",
      "Bash(az monitor metrics list:*)",
      "Bash(gh pr list:*)",
      "Bash(gh repo view:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker info:*)",
      "Bash(docker version:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:kubernetes.io)"
    ],
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(terraform -chdir=* apply:*)",
      "Bash(terraform import:*)",
      "Bash(terraform -chdir=* import:*)",
      "Bash(terraform state:*)",
      "Bash(terraform -chdir=* state:*)",
      "Bash(terraform output:*)",
      "Bash(terraform -chdir=* output:*)",
      "Bash(az * create:*)",
      "Bash(az * update:*)",
      "Bash(az * delete:*)",
      "Bash(az * set:*)",
      "Bash(az * start:*)",
      "Bash(az * stop:*)",
      "Bash(az * register:*)",
      "Bash(az deployment:*)",
      "Bash(az aks get-credentials:*)",
      "Bash(az keyvault secret:*)",
      "Bash(az storage blob:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl get secret:*)",
      "Bash(kubectl get secrets:*)",
      "Bash(kubectl get * secret:*)",
      "Bash(kubectl get * secrets:*)",
      "Bash(terraform show -json:*)",
      "Bash(terraform -chdir=* show -json:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh api -X DELETE:*)"
    ],
    "deny": [
      "Bash(terraform destroy:*)",
      "Bash(terraform -chdir=* destroy:*)",
      "Bash(terraform * -destroy:*)",
      "Bash(terraform apply * -auto-approve:*)",
      "Bash(terraform apply -auto-approve:*)",
      "Bash(terraform -chdir=* apply * -auto-approve:*)",
      "Bash(terraform -chdir=* apply -auto-approve:*)",
      "Bash(terraform force-unlock:*)",
      "Bash(az group delete:*)",
      "Bash(az role assignment create:*)",
      "Bash(az role assignment delete:*)",
      "Bash(az ad:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit --visibility:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force:*)",
      "Bash(git push * -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r -f:*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.terraform/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secrets.py\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/terraform_check.py\"", "timeout": 180 }]
      }
    ]
  }
}
