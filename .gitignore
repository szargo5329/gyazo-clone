# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.auto.tfvars
!infra/terraform/envs/*/terraform.tfvars

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
kubeconfig

# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/

# Claude local
.claude/settings.local.json

# Terraform backend config (generated names, not secret; only the .example is committed)
infra/terraform/envs/*/backend.hcl

# Modules are not root configs; only root lock files are committed
infra/terraform/modules/**/.terraform.lock.hcl
